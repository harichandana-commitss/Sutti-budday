:root { --ink:#25372d; --paper:#fbf8ec; --coral:#d9896f; --pink:#e5d8c2; --lav:#cbd8bf; --yellow:#eadb95; --mint:#c4d9c4; --sage:#dce8d5; --moss:#44634e; --forest:#1d392b; }
* { box-sizing:border-box; }
