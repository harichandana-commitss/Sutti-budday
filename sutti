eenshot:nth-child(3n+2){--chat-turn:1deg}.chat-screenshot:nth-child(5n){--chat-turn:.5deg}.chat-screenshot:hover { transform:rotate(0) translateY(-7px) scale(1.015); box-shadow:0 20px 36px rgba(0,0,0,.32); }.chat-screenshot img { display:block; width:100%; height:auto; }.chat-lightbox { max-width:min(92vw,1000px); max-height:92vh; padding:12px; border:0; background:#fffaf0; box-shadow:0 24px 80px rgba(0,0,0,.45); }.chat-lightbox::backdrop { background:rgba(13,27,20,.82); }.chat-lightbox img { display:block; max-width:100%; max-height:calc(92vh - 24px); }.chat-lightbox-close { position:absolute; top:-15px; right:-15px; width:38px; height:38px; border:0; border-radius:50%; background:var(--yellow); color:var(--forest); font:28px/1 sans-serif; cursor:pointer; }
