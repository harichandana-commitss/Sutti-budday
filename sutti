hild { grid-column:auto; }.year-two-photos figure:first-child .gallery-photo,.year-two-photos .gallery-photo { min-height:0; height:220px; }.year-two-photos figcaption { padding:8px 3px; overflow:hidden; }.coral-card{background:#d9ac8a}.lavender-card{background:#cbd8bf}.yellow-card{background:#e4d993}.mint-card{background:#b9d2bc}
.memories { background:#f1eee7; }.section-heading { display:flex; justify-content:space-between; align-items:flex-start; }.memory-grid { margin-top:60px; display:grid; grid-template-columns:1.1fr .9fr .9fr; grid-template-rows:300px 300px; gap:20px; }.memory { margin:0; padding:16px; display:flex; flex-direction:column; justify-content:space-between; transform:rotate(var(--turn,0deg)); transition:transform .3s ease; }.memory:hover { transform:rotate(0) translateY(-7px); }.memory-tall { grid-row:span 2; --turn:-2deg; }.memory:nth-child(2){--turn:2deg}.memory:nth-child(3){--turn:-1deg}.memory:nth-child(4){--turn:1deg}.peach{background:#efad9f}.lavender{background:var(--lav)}.yellow{background:var(--yellow)}.mint{background:var(--mint)}.photo-placeholder { height:calc(100% - 38px); border:1px dashed rgba(38,49,61,.38); display:grid; place-content:center; text-align:center; color:rgba(38,49,61,.65); font:11px/1.5 "DM Mono",monospace; text-transform:uppercase; letter-spacing:.1em; }.photo-placeholder span { font-size:24px; margin-top:6px; }.memory p { margin:12px 0 0; font-size:12px; }
.wish { min-height:80vh; background:#dbe6cc; display:flex; align-items:center; justify-content:space-between; gap:30px; overflow:hidden; }.wish-inner { position:relative; z-index:1; }.wish h2 { margin:22px 0 32px; }.wish-message { margin:20px 0 0; min-height:22px; font-family:"DM Serif Display",serif; font-size:21px; color:var(--moss); }.cake { position:relative; width:260px; height:260px; flex-shrink:0; }.cake-body { position:absolute; height:110px;width:210px;bottom:45px;left:25px;background:#789968;border-radius:14px 14px 36px 36px;display:flex;gap:42px;justify-content:center;padding-top:18px;overflow:hidden; }.cake-body span { width:16px;height:90px;background:#edf2db;border-radius:50%; }.cake-top { position:absolute;width:210px;height:40px;bottom:135px;left:25px;background:#fff9e8;border-radius:50%;z-index:1; }.cake-plate { position:absolute;width:245px;height:20px;bottom:34px;left:8px;background:#d5c778;border-radius:50%; }.wick { position:absolute;width:4px;height:27px;bottom:174px;left:128px;background:#333;z-index:2; }.flame { position:absolute;width:23px;height:37px;bottom:197px;left:119px;background:#ffd46d;border-radius:60% 40% 65% 35%;transform:rotate(45deg);z-index:3;box-shadow:0 0 27px #f7c463;animation:flicker .7s infinite alternate; }.flame.out{opacity:0;transform:scale(.1);transition:.45s}
